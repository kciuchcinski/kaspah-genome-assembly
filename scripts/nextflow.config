// clinopore-nf settings for the v2 hybrid assembly.
//
// Deliberately free of absolute paths: 16_run_clinopore.sh passes --reads and the
// conda environment locations. An earlier copy of this file hardcoded a reads glob into
// a different project, which is how a run can silently assemble the wrong cohort.

conda.enabled = true

// Input options
params.reads = "${launchDir}/08_hybrid_asm/reads/*.fastq.gz"

// dna_r10.4.1_e8.2_400bps_sup@v4.3.0 basecalls (5 kHz), the same chemistry and model as
// the v1 runs, so the same Medaka model as every earlier KASPAH assembly.
params.medaka_model = 'r1041_e82_400bps_sup_g615'

// Run options — reads are already QC'd (fastp / Filtlong in 02_reads, and Filtlong again
// for the decontaminated ones), so no further filtering here.
params.filter_reads = 'false'
params.long_read_polish = 'true'
params.short_read_polish = 'true'

// No params.flye_args here: the pipeline never reads it. Flye is invoked as
// `flye --nano-hq ... --threads ${params.threads}` in src/processes/assemble.nf, so
// setting it (as the v1 script did, --flye_args="--meta") changes nothing.

// Output options
params.outdir = "${launchDir}/08_hybrid_asm/clinopore_out"
params.read_qc = 'false'
params.polishing_stats = 'true'

// Compute (local executions)
params.failure_action = 'terminate'
params.threads = 16

// SLURM parameters
params.max_retries = 3
params.queue_size = 50
params.slurm_account = ''          // set to your cluster account

profiles {
  slurm {
    executor {
      name = 'slurm'
      queueSize = params.queue_size
      submitRateLimit = '2/1.seconds'
      jobName = { "clinopore-${task.name}".replace(' ', '_') }
    }

    process {
      // Retry jobs with more resources
      maxRetries = params.max_retries
      errorStrategy = { task.attempt < params.max_retries ? 'retry' : 'ignore' }

      // Required for consistent resumes on NFS
      cache = 'lenient'

      // Default queue configuration
      queue = ''                  // set to your cluster partition

      // derived from the param, so changing the account in one place is enough
      clusterOptions = "-A ${params.slurm_account}"

      // Job-specific resource allocations.
      //
      // cpus is tied to params.threads because the pipeline interpolates ${params.threads}
      // into the tool command lines rather than ${task.cpus} — so the two must agree or
      // the request and the actual thread count drift apart. Inherited from v1, they did:
      // ASSEMBLE reserved 64 cores to run Flye on 16, while MEDAKA, POLYPOLISH and POLCA
      // each asked SLURM for 2 cores and then ran 16 threads on them.
      withLabel: short_job {
        time = { 30.minutes * task.attempt }
        memory = { 1.GB * task.attempt }
        cpus = 1
      }

      // MEDAKA, POLYPOLISH, POLCA
      withLabel: medium_job {
        time = { 2.hour * task.attempt }
        memory = { 32.GB * task.attempt }
        cpus = params.threads
      }

      // ASSEMBLE (Flye)
      withLabel: long_job {
        time = { 2.hour * task.attempt }
        memory = { 64.GB * task.attempt }
        cpus = params.threads
      }

      // v1 also carried a very_long_job label. No process in clinopore-nf declares it —
      // only short_job, medium_job and long_job are used — so it is dropped rather than
      // left here contradicting the cpus rule above.
    }
  }

  standard {
    executor {
      name = 'local'
      queueSize = params.threads
    }
    process {
      memory = '16 GB'
      cpus = 16
      errorStrategy = "${params.failure_action}"
    }
  }
}
